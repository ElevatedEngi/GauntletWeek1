```typescript
// apps/backend/src/services/ai/AIAgent.ts

class AIAgent {
  async executeCommand(
    command: string,
    boardId: string,
    userId: string
  ): Promise<CommandResult> {
    try {
      // 1. Check cache (60% hit rate expected)
      const cached = await this.cache.get(this.hashCommand(command));
      if (cached) return cached;

      // 2. Get current board state
      const board = await this.boardService.getBoardState(boardId);

      // 3. Call Claude API with structured prompt
      const aiResponse = await this.callClaude(command, board);

      // 4. Validate response schema
      const validated = this.validateResponse(aiResponse);

      // 5. Execute on board
      const result = await this.executeBoardOperations(validated, boardId, userId);

      // 6. Cache result
      await this.cache.set(this.hashCommand(command), result, 86400); // 24hr

      return result;

    } catch (error) {
      // ZERO CRASHES REQUIREMENT: Always return graceful error
      return {
        success: false,
        error: this.sanitizeError(error),
        fallback: this.suggestAlternative(command)
      };
    }
  }

  private async callClaude(command: string, boardState: BoardState): Promise<string> {
    const prompt = `
You are a whiteboard AI assistant. Execute the following command accurately.

<board_state>
${JSON.stringify(this.simplifyBoardState(boardState), null, 2)}
</board_state>

<user_command>
${command}
</user_command>

<available_actions>
${JSON.stringify(AVAILABLE_ACTIONS)}
</available_actions>

CRITICAL RULES:
1. Respond ONLY with valid JSON
2. Use only actions from AVAILABLE_ACTIONS
3. Infer reasonable defaults if parameters missing
4. For spatial commands, use current board state
5. If ambiguous, choose most likely interpretation

RESPONSE FORMAT:
{
  "action": "create" | "move" | "delete" | "edit" | "multi_step",
  "object_type": "sticky_note" | "circle" | "rectangle",
  "params": { /* action-specific parameters */ }
}
`;

    const response = await this.claude.messages.create({
      model: 'claude-sonnet-4-20250514',
      max_tokens: 1000,
      temperature: 0.2, // Low temperature for consistency
      messages: [{ role: 'user', content: prompt }]
    });

    return response.content[0].text;
  }

  private sanitizeError(error: any): string {
    // Never expose internal errors to user
    const safeErrors = {
      'timeout': 'Command took too long. Try a simpler operation.',
      'invalid_command': 'I couldn\'t understand that command. Try rephrasing.',
      'board_not_found': 'Board not found.',
      'permission_denied': 'You don\'t have permission to modify this board.'
    };

    for (const [key, message] of Object.entries(safeErrors)) {
      if (error.message?.includes(key)) {
        return message;
      }
    }

    return 'An unexpected error occurred. Please try again.';
  }
}
