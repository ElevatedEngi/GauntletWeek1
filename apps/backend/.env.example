// Copy this file to .env.local and fill in the values

PORT=3000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-long-for-security
NODE_ENV=development

# Anthropic
ANTHROPIC_API_KEY=sk-your-api-key

# LangChain / LangSmith Tracing
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=ls-your-langsmith-api-key
LANGCHAIN_PROJECT=whiteboard-ai

# Redis (auto-configured by Docker Compose)
# REDIS_URL=redis://redis:6379

# Firebase Admin (for AI agent to write to Realtime DB)
FIREBASE_DATABASE_URL=https://whiteboard-collab-98431547-default-rtdb.firebaseio.com
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
# Or: FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Langfuse (optional)
# LANGFUSE_SECRET_KEY=sk-lf-your-key
# LANGFUSE_PUBLIC_KEY=pk-lf-your-key
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
